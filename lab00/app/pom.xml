<!-- UD01 · Progetto Maven di Catalogo: applicazione Spring Boot che produce target/catalogo.jar. -->
<!-- Radice del progetto Maven; gli attributi xmlns/xsi indicano lo schema XML usato per validare il file. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!-- Versione del formato del file pom.xml. -->
  <modelVersion>4.0.0</modelVersion>
  <!-- Progetto padre: spring-boot-starter-parent 4.0.8 fissa le versioni delle librerie, così sotto non vanno scritte. relativePath vuoto: il padre si scarica da Maven Central, non da una cartella locale. -->
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.0.8</version><relativePath/></parent>
  <!-- Identità di questo progetto: gruppo, nome (artifactId) e versione. -->
  <groupId>it.lab</groupId><artifactId>catalogo</artifactId><version>1.0.0</version>
  <!-- Versione di Java usata per compilare: 17. -->
  <properties><java.version>17</java.version></properties>
  <dependencies>
    <!-- Starter web: server HTTP e framework MVC per esporre le API REST. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <!-- Actuator: endpoint di controllo (health, info), usati anche dalle probe di OpenShift. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <!-- Librerie di test (JUnit): scope "test", quindi non entrano nel JAR finale. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <!-- finalName: il JAR si chiama catalogo.jar (senza versione), nome atteso dal Dockerfile. Il plugin Spring Boot lo rende eseguibile con java -jar. -->
  <build><finalName>catalogo</finalName><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
